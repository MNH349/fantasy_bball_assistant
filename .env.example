# Copy this file to `.env` and fill in your values. `.env` is git-ignored — never commit it.

# Your ESPN league id (from the league URL). Already known:
LEAGUE_ID=349026539

# The season ESPN uses for the 26-27 campaign. Usually the ENDING year.
# Confirmed at first connect; leave as 2027 unless diagnostics says otherwise.
SEASON=2027

# --- Private-league auth cookies (SENSITIVE — treat like a password) ---
# How to get them: log into fantasy.espn.com in your browser, open DevTools
# (F12) -> Application/Storage -> Cookies -> https://fantasy.espn.com, and copy
# the VALUES of these two cookies.
#
# espn_s2 is a long URL-encoded string. SWID looks like {XXXXXXXX-XXXX-...}.
# Note: espn_s2 expires roughly once a year — if the tool stops connecting,
# refresh these two values first.
ESPN_S2=
SWID=
